# LEASH Gateway Configuration
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8000
TOOLS_HOST=127.0.0.1
TOOLS_PORT=8001

# Shared HMAC secret between LEASH Gateway and Protected Tool Server
# In production, specify a high-entropy 32-byte hex secret.
# If omitted in development, an ephemeral secret is automatically generated in data/.hmac_secret.
GATEWAY_HMAC_SECRET=

# Database paths
BUSINESS_DB_PATH=data/business_systems.db
AUDIT_DB_PATH=data/audit_log.db

# Optional LLM API Key (Phase 5 live agent)
# OPENAI_API_KEY=
